# LiveKit Cloud project settings.
# Create a project at https://cloud.livekit.io/ and copy these from Settings -> Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram API key. Used for Russian speech-to-text (Nova-3).
# Create a key at https://console.deepgram.com/ or reuse an existing project key.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=ru

# Russian text-to-speech provider.
# Deepgram Aura TTS is not a good Russian default, so the MVP uses ElevenLabs for TTS.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
