# LiveKit Cloud project settings.
# Create a project at https://cloud.livekit.io/ and copy these from Settings -> Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram API key. Used for speech-to-text (Nova-3).
# Create a key at https://console.deepgram.com/ or reuse an existing project key.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=en

# Text-to-speech provider.
# ElevenLabs is the default for the source-built dev workflow.
TTS_PROVIDER=elevenlabs
TTS_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
